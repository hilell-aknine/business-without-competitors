# Local project docs (contains credentials and internal notes)
# These must NOT be tracked: the GitHub Pages mirror serves every tracked
# file publicly, ignoring .vercelignore. Keep them on disk, out of git.
CLAUDE.md
SKILL.md
primer.md
hindsight.md
audit-*.md
supabase-test.html

# Course materials (paid content — not for public repo)
*.pdf
*.zip

# Archived background docs (PDFs, ZIPs, source materials)
docs-archive/

# Workbook builder + generated workbooks (audio, transcripts, drafts, PDFs)
# 2026-08-02: narrowed from /tools/ so the small one-time pipeline scripts
# (split-kb.mjs, assemble-game-data.mjs) ARE tracked; heavy media stays out.
/tools/workbook-builder/
/workbooks/

# Project-100 methodology KB (transcripts belong to Zvika/Bar — never publish)
kb-project-100/

# Course transcript source-of-truth (4.2MB plaintext, 8 modules + seminars).
# 2026-08-07: rescued out of C:\Users\saraa\.claude\tmp-audit\kb\ — a temp dir
# that gets cleaned. This is the irreplaceable input to split-kb.mjs and
# assemble-game-data.mjs. PAID CONTENT: the repo is public and GitHub Pages
# serves every tracked file, so plaintext must never be committed.
kb-transcripts/

# Course transcript KB: the repo is PUBLIC, so only the encrypted form
# (*.json.enc, AES-256-GCM, key in Vercel env KB_SECRET) is committed.
# Plaintext stays local for dev. _index.json is harmless metadata (titles).
api/_kb/*.json
!api/_kb/_index.json

# Internal tooling / non-product content (added 2026-07-28)
.clinerules
fixes-*.json
מה-זה.txt
שיווק-אטומי-לימוד/

# Supabase CLI link state (local only)
supabase/.temp/
